# Elora — site-wide settings (Apache / LiteSpeed)
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # https is enforced by Cloudflare ("Always Use HTTPS"), so this origin redirect stays off
  # to avoid redirect loops. Only re-enable if the site stops using Cloudflare.
  # RewriteCond %{HTTP_HOST} ^(www\.)?elorafashion\.co\.uk$ [NC]
  # RewriteCond %{HTTPS} !=on [OR]
  # RewriteCond %{HTTP_HOST} ^www\. [NC]
  # RewriteRule ^ https://elorafashion.co.uk%{REQUEST_URI} [L,R=301]
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Keep repo housekeeping files private
<FilesMatch "^(README\.md|\.cpanel\.yml)$">
  Require all denied
</FilesMatch>
